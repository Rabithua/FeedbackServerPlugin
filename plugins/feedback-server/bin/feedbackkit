#!/usr/bin/env bun

import {
  ensureRuntimeDependencies,
  relaunchCurrentProcess,
} from '../scripts/ensure-runtime-dependencies.ts';

if (ensureRuntimeDependencies()) {
  process.exit(await relaunchCurrentProcess());
}
const { main } = await import('../dist/cli.mjs');
await main(Bun.argv.slice(2));
