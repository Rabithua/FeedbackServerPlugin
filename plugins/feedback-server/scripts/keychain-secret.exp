#!/usr/bin/expect -f

log_user 0
set timeout 15
set secret [gets stdin]
if {$secret eq "" && [eof stdin]} { exit 64 }

proc finish {} {
  set result [wait]
  exit [lindex $result 3]
}

spawn -noecho {*}$argv
expect {
  -nocase -re {password data.*: *$} {}
  eof { finish }
  timeout { exit 124 }
}
send -- "$secret\r"
expect {
  -nocase -re {retype password.*: *$} { send -- "$secret\r" }
  eof { finish }
  timeout { exit 124 }
}
expect {
  eof { finish }
  timeout { exit 124 }
}
