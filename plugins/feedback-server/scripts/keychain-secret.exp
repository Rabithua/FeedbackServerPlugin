#!/usr/bin/expect -f

log_user 0
set timeout 15
set secret [gets stdin]
if {$secret eq "" && [eof stdin]} { exit 64 }
set launch_failure_marker "feedback-server-security-launch-failed:"

proc emit_diagnostics {output} {
  global secret
  regsub -all -nocase -- {password data[^\r\n]*: *} $output {} output
  regsub -all -nocase -- {retype password[^\r\n]*: *} $output {} output
  if {$secret ne ""} {
    set output [string map [list $secret {[REDACTED_SECRET]}] $output]
  }
  if {$output ne ""} { puts -nonewline stderr $output }
}

proc finish {} {
  global expect_out
  if {[info exists expect_out(buffer)]} { emit_diagnostics $expect_out(buffer) }
  set result [wait]
  exit [lindex $result 3]
}

if {[catch {spawn -noecho {*}$argv} launch_error]} {
  emit_diagnostics "$launch_failure_marker$launch_error\n"
  exit 127
}
expect {
  -nocase -re {password data.*: *$} {}
  eof { finish }
  timeout { exit 124 }
}
send -- "$secret\r"
expect {
  -nocase -re {retype password.*: *$} { send -- "$secret\r" }
  eof { finish }
  timeout { exit 124 }
}
expect {
  eof { finish }
  timeout { exit 124 }
}
