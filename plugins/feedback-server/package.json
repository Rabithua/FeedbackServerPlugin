{
  "name": "@feedback-server/agent-plugin",
  "version": "0.12.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/server.ts --target=bun --format=esm --minify --external @napi-rs/keyring --outfile=./dist/server.mjs && bun build ./src/cli.ts --target=bun --format=esm --minify --external @napi-rs/keyring --outfile=./dist/cli.mjs && bun run ./scripts/normalize-build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --max-warnings=0",
    "test": "bun test --timeout 10000",
    "test:stdio": "bun run ./scripts/stdio-smoke.ts",
    "test:keyring": "bun run ./scripts/native-keyring-smoke.ts",
    "test:roundtrip": "bun run ./bin/feedback-server test roundtrip",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run test:stdio",
    "accept-invite": "bun run ./bin/feedbackkit accept-invite",
    "onboarding": "bun run ./bin/feedbackkit onboarding status",
    "doctor": "bun run ./bin/feedbackkit doctor"
  },
  "bin": {
    "feedbackkit": "./bin/feedbackkit",
    "feedback-server": "./bin/feedback-server",
    "feedbackkit-mcp": "./bin/feedbackkit-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/keyring": "1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.4.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
