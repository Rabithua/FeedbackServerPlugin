{
  "name": "@feedback-server/codex-plugin",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/server.ts --target=bun --format=esm --minify --outfile=./dist/server.mjs && bun run ./scripts/normalize-build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --max-warnings=0",
    "test": "bun test --timeout 10000",
    "test:contract": "bun run ./scripts/contract-test.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "admin:create-local": "bun run ./src/create-local-admin.ts",
    "admin:invite": "bun run ./src/create-invitation.ts",
    "admin:invitations": "bun run ./src/list-invitations.ts",
    "admin:invite:revoke": "bun run ./src/revoke-invitation.ts",
    "admin:accept-invite": "bun run ./src/accept-invitation.ts",
    "configure": "bun run ./src/configure.ts",
    "disconnect": "bun run ./src/disconnect.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.5",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
