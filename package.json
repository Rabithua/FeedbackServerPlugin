{
  "name": "feedback-server-plugin-marketplace",
  "version": "0.6.13",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun --cwd=plugins/feedback-server run check",
    "validate": "bun run ./scripts/validate-distribution.ts",
    "scan": "bun run ./scripts/check-sensitive-content.ts",
    "doctor": "bun --cwd=plugins/feedback-server run doctor",
    "test:roundtrip": "bun --cwd=plugins/feedback-server run test:roundtrip",
    "agent:configure": "bun --cwd=plugins/feedback-server run configure",
    "agent:disconnect": "bun --cwd=plugins/feedback-server run disconnect",
    "agent:revoke-token": "bun --cwd=plugins/feedback-server run agent:revoke-token",
    "admin:create-local": "bun --cwd=plugins/feedback-server run admin:create-local",
    "admin:invite": "bun --cwd=plugins/feedback-server run admin:invite",
    "admin:invitations": "bun --cwd=plugins/feedback-server run admin:invitations",
    "admin:invite:revoke": "bun --cwd=plugins/feedback-server run admin:invite:revoke",
    "admin:accept-invite": "bun --cwd=plugins/feedback-server run admin:accept-invite"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
